/* app.wxss 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

/* 主按钮 */
.btn-primary {
  background: #4A90D9;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  text-align: center;
  margin: 20rpx 0;
}

.btn-primary[disabled] {
  background: #ccc;
}

/* 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
  padding-left: 20rpx;
  border-left: 6rpx solid #4A90D9;
}

/* 表格 */
.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.table-row .col {
  flex: 1;
  text-align: center;
}
