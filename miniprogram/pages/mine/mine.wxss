/* pages/mine/mine.wxss */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
}
.tab.active {
  color: #4A90D9;
  font-weight: bold;
  border-bottom: 4rpx solid #4A90D9;
}

.loading, .empty { text-align: center; padding: 80rpx; color: #999; }

.schedule-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.schedule-info { flex: 1; }
.schedule-name { font-size: 32rpx; font-weight: bold; display: block; }
.schedule-date { font-size: 26rpx; color: #666; display: block; margin: 8rpx 0; }
.schedule-loc { font-size: 26rpx; color: #999; display: block; }

.schedule-status {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.schedule-status.confirmed { background: #e6ffed; color: #52c41a; }
.schedule-status.pending { background: #fff7e6; color: #d48806; }

.qa-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.qa-question {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.qa-context {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.qa-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #4A90D9;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 我的信息 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.profile-done {
  background: #e6ffed;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx 30rpx;
}
.profile-name { font-size: 30rpx; font-weight: bold; color: #52c41a; display: block; }
.profile-sub { font-size: 26rpx; color: #666; display: block; margin-top: 8rpx; }

.field { margin-bottom: 24rpx; }
.field-label { display: block; font-size: 26rpx; color: #666; margin-bottom: 10rpx; }
.field-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}
.text-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  min-height: 120rpx;
}
.hint { font-size: 24rpx; color: #999; margin-top: 16rpx; }

.recognize-result {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}
.rr-title { font-size: 28rpx; font-weight: 500; color: #333; margin-bottom: 10rpx; }
.rr-user { font-size: 26rpx; color: #555; }
.rr-count { display: block; font-size: 24rpx; color: #4A90D9; margin-top: 8rpx; }

.link { color: #4A90D9; font-size: 30rpx; }

/* 网络诊断 */
.current-host {
  font-size: 26rpx;
  color: #4A90D9;
  background: #f7f9fc;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  word-break: break-all;
}
.diag-list { margin-top: 20rpx; }
.diag-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}
.diag-item.ok { background: #e6ffed; }
.diag-item.fail { background: #fff1f0; }
.diag-main { display: flex; align-items: flex-start; flex: 1; }
.diag-icon { font-size: 34rpx; margin-right: 14rpx; }
.diag-info { display: flex; flex-direction: column; flex: 1; }
.diag-host { font-size: 26rpx; font-weight: bold; color: #333; }
.diag-msg { font-size: 24rpx; color: #666; margin-top: 6rpx; }
.diag-raw { font-size: 22rpx; color: #999; margin-top: 6rpx; word-break: break-all; }
.diag-tap { font-size: 24rpx; color: #4A90D9; margin-left: 10rpx; }
