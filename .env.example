# ============================================================
# schedule-extractor 环境变量示例
# 复制本文件为 .env 后按需修改；.env 不要提交到 Git（已在 .gitignore）
# ============================================================

# ===== 后端服务 =====
# 开发调试可用 true；正式环境必须 false
DEBUG=false
# 127.0.0.1 仅本机访问；小程序真机局域网调试时用 0.0.0.0
HOST=127.0.0.1
PORT=5000
# 上传文件大小上限（MB）
MAX_UPLOAD_MB=10

# ===== PC 端访问后端的地址 =====
# Streamlit 与划词插件读取（运行 PC 端的机器上配置）
API_BASE=http://127.0.0.1:5000

# ===== AI 大模型（OpenAI 兼容接口，可对接 DeepSeek/通义千问/智谱等）=====
# 不配置时后端自动使用正则规则兜底（只能识别格式规整的排班文本）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ===== 微信小程序配置 =====
# 订阅消息模板ID（在微信公众平台配置后填写）
WECHAT_TEMPLATE_ID=
